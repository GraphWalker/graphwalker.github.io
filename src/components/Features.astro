---
import SectionHeader from './SectionHeader.astro';

const features = [
  {
    title: 'Model Context Protocol (MCP)',
    desc: 'An MCP server lets AI clients build, validate, convert, and execute GraphWalker models over stdio.',
    icon: 'sparkles',
  },
  {
    title: 'Multiple path generators',
    desc: 'Random, quick random, weighted random, A*, shortest all paths, predefined path, and New York Street Sweeper (Chinese Postman).',
    icon: 'routes',
  },
  {
    title: 'Flexible stop conditions',
    desc: 'Edge or vertex coverage, reached element, time duration, path length, requirement coverage, plus AND/OR combinations.',
    icon: 'flag',
  },
  {
    title: 'Guards and actions',
    desc: 'Edges can carry boolean guards and script actions that modify execution state while a path is generated.',
    icon: 'shield',
  },
  {
    title: 'Multi-model support',
    desc: 'Coordinate across several models using shared states for bigger, realistic test suites.',
    icon: 'layers',
  },
  {
    title: 'Requirements tracking',
    desc: 'Tag elements with requirement IDs and see exactly which of them your generated paths cover.',
    icon: 'target',
  },
  {
    title: 'Multiple interfaces',
    desc: 'A CLI for offline batch generation and online services over REST and WebSocket for live execution.',
    icon: 'plug',
  },
  {
    title: 'Visual Studio editor',
    desc: 'A web-based Studio to model, verify, and run test paths from the browser.',
    icon: 'window',
  },
  {
    title: 'Deterministic replay',
    desc: 'Seed-based random generation makes experiments reproducible, run after run.',
    icon: 'cycle',
  },
] as const;

const icons: Record<string, string> = {
  routes: 'M5 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm14 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM5 9a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm0 6 14-8',
  flag: 'M4 21V4m0 0h13a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H4',
  shield: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z',
  layers: 'm12 2 9 5-9 5-9-5 9-5Zm-9 10 9 5 9-5M12 22v-5',
  target: 'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Zm0-6a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z',
  plug: 'M9 2v6M15 2v6M5 8h14v3a7 7 0 0 1-14 0V8Zm7 7v7',
  window: 'M2 4h20v16H2V4Zm0 5h20M6 7h.01M10 7h.01',
  sparkles: 'M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z',
  cycle: 'M21 12a9 9 0 1 1-2.6-6.3M21 3v6h-6',
};
---

<section id="features" class="bg-white dark:bg-night-950">
  <div class="mx-auto max-w-6xl px-4 py-20 md:py-24">
    <SectionHeader
      eyebrow="features"
      title="Everything you need for model-based testing"
      subtitle="Model your system as a directed graph, then let GraphWalker turn it into verifiable test paths."
    />

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        features.map((f) => (
          <div
            class="group rounded-xl border border-zinc-200 bg-white p-6 transition hover:-translate-y-0.5 hover:border-rust-400/60 hover:shadow-lg hover:shadow-rust-600/5 dark:border-white/10 dark:bg-night-900 dark:hover:border-rust-400/40"
          >
            <div
              class="mb-4 grid h-11 w-11 place-items-center rounded-lg bg-rust-400/15 text-rust-600 dark:text-rust-400"
            >
              <svg
                class="h-5 w-5 stroke-current"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.8"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d={icons[f.icon]} />
              </svg>
            </div>
            <h3 class="font-semibold text-zinc-900 dark:text-white">{f.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-300">
              {f.desc}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>